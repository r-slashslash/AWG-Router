# install.sh normally writes this file. All settings with explanations.

# Panel password (install.sh generates 16 characters)
PANEL_PASSWORD=
# Panel port (install.sh picks a random 4-digit one) and listen address:
#   0.0.0.0   — open in a browser over HTTPS
#   127.0.0.1 — only through an SSH tunnel
PANEL_PORT=5831
PANEL_HOST=0.0.0.0
# Secret part of the address: https://IP:PORT/THIS/
PANEL_BASE_PATH=/a1b2c3d4e5f6
# How you open the panel (for install.sh only): public — over HTTPS | ssh — through an SSH tunnel
PANEL_ACCESS=public

# Public address of the server (IP or a domain): client configs, and the
# certificate when no panel domain is set
PUBLIC_HOST=
# HTTPS: letsencrypt (6-day IP certificate, renews itself) | selfsigned | off
TLS_MODE=letsencrypt
# Domain instead of the IP for the certificate (optional) and e-mail for Let's Encrypt
TLS_DOMAIN=
ACME_EMAIL=
# Optional Cloudflare API token for Let's Encrypt DNS-01 challenge (domain only, no port 80 needed)
CF_DNS_API_TOKEN=

# AWG server: container (AmneziaVPN container) | host (AmneziaWG on the host) | auto
AWG_MODE=auto
# host mode: create a server on this UDP port and subnet on first start
AWG_INIT_PORT=
AWG_INIT_SUBNET=10.8.1.0/24
# container mode: the AmneziaVPN container (empty — amnezia-awg2, then amnezia-awg)
# and the server's interface (empty — from the .conf name: awg0 / wg0)
AWG_CONTAINER=
AWG_IFACE=
# Tunnels to exits: auto — the same engine as the AWG server (the kernel module when awg-quick took it,
# otherwise amneziawg-go); go | kernel — always that one, e.g. to read amneziawg-go logs while debugging
EXIT_ENGINE=auto
# Seconds between the panel's passes over the server
RECONCILE_INTERVAL=10
# Port of the handler for domain rules in the server's network (TCP, inside the AWG server)
SNI_PROXY_PORT=10443
# Port the Let's Encrypt check listens on: Let's Encrypt comes to port 80, so change it only
# when port 80 is forwarded to another one
ACME_HTTP_PORT=80
# 1 — demo mode without touching the server
DRY_RUN=0
# Written by install.sh: the .env format and the user in the ssh tunnel command
# AWGR_VERSION=2
# SSH_USER=root
