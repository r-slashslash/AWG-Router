# install.sh normally writes this file. All settings with explanations.

# Panel password (install.sh generates 16 characters)
PANEL_PASSWORD=
# Panel port (install.sh picks a random 4-digit one) and listen address:
#   0.0.0.0   — open in a browser over HTTPS
#   127.0.0.1 — only through an SSH tunnel
PANEL_PORT=5831
PANEL_HOST=0.0.0.0
# Secret part of the address: https://IP:PORT/THIS/
PANEL_BASE_PATH=/a1b2c3d4e5f6
PANEL_ACCESS=public

# Public address of the server: used in client configs and for the certificate
PUBLIC_HOST=
# HTTPS: letsencrypt (6-day IP certificate, renews itself) | selfsigned | off
TLS_MODE=letsencrypt
# Domain instead of the IP for the certificate (optional) and e-mail for Let's Encrypt
TLS_DOMAIN=
ACME_EMAIL=

# AWG server: container (AmneziaVPN container) | host (AmneziaWG on the host) | auto
AWG_MODE=auto
# host mode: create a server on this UDP port on first start
AWG_INIT_PORT=
# Tunnels to exits: userspace (amneziawg-go) | kernel (amneziawg module on the host)
UPSTREAM_BACKEND=userspace
RECONCILE_INTERVAL=10
# 1 — demo mode without touching the server
DRY_RUN=0
